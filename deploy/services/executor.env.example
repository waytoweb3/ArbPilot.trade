# 复制为 executor.env 后填入真实值（不要提交到仓库）。
# 执行器只连接内网 Postgres，不对外暴露 5432。
DATABASE_URL=postgres://arbpilot:CHANGE_ME@postgres:5432/arbpilot_exec

# 桌面端调用执行器的 Bearer 令牌；用 openssl rand -hex 32 生成。
ARBPILOT_API_TOKEN=CHANGE_ME

# 自托管可关闭授权校验；对外提供服务时改成 true 并配置账号服务公钥。
ARBPILOT_LICENSE_REQUIRED=false
# ARBPILOT_LICENSE_PUBLIC_KEY=

# 官方托管实例开启后只放行行情、资金费率、资讯与策略市场只读接口，
# 账户密钥、下单、策略、风控与 Telegram 一律拒绝，避免用户把 API Key 交给官方服务器。
ARBPILOT_PUBLIC_MODE=false

RUST_LOG=info,arbpilot_executor=info

# 需要走代理访问交易所行情时填写。
# ARBPILOT_MARKET_PROXY=http://127.0.0.1:7897

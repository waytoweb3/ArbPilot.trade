# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY apps/executor ./apps/executor
COPY apps/desktop/src-tauri/Cargo.toml ./apps/desktop/src-tauri/Cargo.toml

RUN cargo build --release -p arbpilot-executor

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 arbpilot \
    && mkdir -p /home/arbpilot/data \
    && chown -R arbpilot:arbpilot /home/arbpilot

COPY --from=builder /app/target/release/arbpilot-executor /usr/local/bin/arbpilot-executor

# 账户凭证、风控限额与 Telegram 绑定默认写在 data/ 下，需挂载卷持久化。
WORKDIR /home/arbpilot
USER arbpilot
EXPOSE 8787
ENTRYPOINT ["arbpilot-executor"]

# 执行器（apps/executor）
ARBPILOT_BIND_ADDR=127.0.0.1:8787
ARBPILOT_API_TOKEN=dev-local-token
DATABASE_URL=postgres://arbpilot:arbpilot@127.0.0.1:5432/arbpilot
# 零配置本地库：桌面端随包启动时自动注入；手动调试也可以直接指向 SQLite 文件。
# DATABASE_URL 留空时使用该文件，两者都为空则以内存模式运行。
# ARBPILOT_LOCAL_DB=data/executor.db
RUST_LOG=info,arbpilot_executor=debug,tower_http=info

# 资金费率采集（公开行情接口，无需 API Key）
# 默认覆盖 Binance / OKX / Bybit / Bitget / Gate 的全市场 USDT 本位永续
ARBPILOT_FUNDING_ENABLED=true
# 留空 = 自动采集交易所全部 USDT 本位永续；填逗号分隔的交易对则只采这些
ARBPILOT_FUNDING_SYMBOLS=
# 盘口与套利机会的交易对（逐币 REST 兜底，数量不宜过多）
ARBPILOT_MARKET_SYMBOLS=BTCUSDT,ETHUSDT
# 当期费率增量刷新间隔（秒），最小 15；有批量接口的交易所一轮覆盖全市场
ARBPILOT_FUNDING_POLL_SECS=30
# 需要代理时改成可访问的镜像或自建转发地址
ARBPILOT_BINANCE_FAPI_URL=https://fapi.binance.com
# Binance 现货公开行情地址（盘口与 K 线）
ARBPILOT_BINANCE_SPOT_URL=https://api.binance.com
# OKX 公开行情地址与开关（资金费率、盘口、K 线）
ARBPILOT_OKX_ENABLED=true
ARBPILOT_OKX_BASE_URL=https://www.okx.com
# Bybit / Bitget / Gate 资金费率开关与公开行情地址
ARBPILOT_BYBIT_ENABLED=true
ARBPILOT_BYBIT_BASE_URL=https://api.bybit.com
ARBPILOT_BITGET_ENABLED=true
ARBPILOT_BITGET_BASE_URL=https://api.bitget.com
ARBPILOT_GATE_ENABLED=true
ARBPILOT_GATE_BASE_URL=https://api.gateio.ws
# HTX / MEXC / BingX 永续公开行情与私有接口地址
ARBPILOT_HTX_ENABLED=true
ARBPILOT_HTX_BASE_URL=https://api.hbdm.com
ARBPILOT_MEXC_ENABLED=true
ARBPILOT_MEXC_BASE_URL=https://contract.mexc.com
ARBPILOT_BINGX_ENABLED=true
ARBPILOT_BINGX_BASE_URL=https://open-api.bingx.com
# WebSocket 行情地址：盘口与当期资金费率优先走推送，REST 只在缺失/过期时兜底
# Binance 现货 bookTicker
ARBPILOT_BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443
# Binance USDT 本位永续 bookTicker
ARBPILOT_BINANCE_FUTURES_WS_URL=wss://fstream.binance.com
# OKX 公共频道（tickers / funding-rate），端口 443
ARBPILOT_OKX_WS_URL=wss://ws.okx.com/ws/v5/public
# 盘口轮询间隔（秒），需小于风控的 max_quote_age_secs（默认 5 秒）
ARBPILOT_QUOTE_POLL_SECS=3
# 访问交易所公开行情使用的 HTTP 代理（留空则直连；也会读取 HTTPS_PROXY）
ARBPILOT_MARKET_PROXY=

# 交易账户余额采集（在总览页导入的交易所 API Key）
# 密钥只保存在执行器所在服务器，不会回传桌面端
ARBPILOT_ACCOUNTS_FILE=data/accounts.json
# 余额与权益快照采集间隔（秒），最小 30
ARBPILOT_ACCOUNTS_POLL_SECS=300

# 设置页修改的风控限额保存路径；文件存在时优先于上面的环境变量
ARBPILOT_RISK_FILE=data/risk_limits.json

# Telegram 机器人（可选）：Token 只保存在执行器所在服务器，不会回传桌面端
# 留空则设置页显示「未启用」，不启动轮询
ARBPILOT_TELEGRAM_BOT_TOKEN=
# 默认随 Token 自动启用；设为 false 可保留 Token 但关闭轮询
# ARBPILOT_TELEGRAM_ENABLED=true
# Bot API 根地址，可指向自建反代
ARBPILOT_TELEGRAM_API_BASE=https://api.telegram.org
ARBPILOT_TELEGRAM_POLL_SECS=3
# 一次性配对码有效期（秒）
ARBPILOT_TELEGRAM_PAIRING_SECS=600
ARBPILOT_TELEGRAM_BINDINGS_FILE=data/telegram_bindings.json

# 策略代码生成（可选）：OpenAI 兼容 chat/completions 接口
# 密钥只保存在执行器本机，不写日志也不回传桌面端；留空时只能手动编写代码
ARBPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
ARBPILOT_LLM_API_KEY=
ARBPILOT_LLM_MODEL=deepseek-v4-flash
ARBPILOT_LLM_TIMEOUT_SECS=60

# 账号授权校验（可选，默认关闭）
# 开启后套利与策略模块需要账号服务签发的 Ed25519 令牌；令牌由桌面端登录后写入执行器，
# 执行器只用公钥离线验签，不联网、也拿不到任何交易凭证。
ARBPILOT_LICENSE_REQUIRED=false
# 取自账号服务 GET /api/license/public-key 的 publicKey（SPKI DER 的 base64）
ARBPILOT_LICENSE_PUBLIC_KEY=
# 令牌过期后仍可离线运行的宽限小时数
ARBPILOT_LICENSE_GRACE_HOURS=72
ARBPILOT_LICENSE_FILE=data/license.json

# 桌面端（apps/desktop）
# 托管模式（自建执行器）在桌面端「设置 → 连接」里填写自己服务器的地址与令牌，地址支持域名或 IP。
VITE_EXECUTOR_TOKEN=dev-local-token
# 官方只读数据接口（资金费率、新闻、行情），非托管模式默认使用 https://exec.arbpilot.trade；
# 需要指向别的数据服务时取消注释覆盖。
# VITE_ARBPILOT_DATA_URL=https://exec.arbpilot.trade

# 执行器（apps/executor）
ARBPILOT_BIND_ADDR=127.0.0.1:8787
ARBPILOT_API_TOKEN=dev-local-token
# paper | live；live 还需显式打开 ARBPILOT_ALLOW_LIVE_TRADING
ARBPILOT_MODE=paper
ARBPILOT_ALLOW_LIVE_TRADING=false
DATABASE_URL=postgres://arbpilot:arbpilot@127.0.0.1:5432/arbpilot
RUST_LOG=info,arbpilot_executor=debug,tower_http=info

# 桌面端（apps/desktop）
VITE_EXECUTOR_URL=http://127.0.0.1:8787

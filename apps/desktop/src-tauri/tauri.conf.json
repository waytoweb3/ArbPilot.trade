{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArbPilot",
  "version": "0.1.0",
  "identifier": "trade.arbpilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArbPilot",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "自托管套利与量化交易终端",
    "longDescription": "ArbPilot 是面向国际用户的自托管量化交易终端：资金与密钥留在用户自己的设备或服务器，桌面端负责配置与监控，所有订单统一经过执行器风控。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

# 复制为 apps/payments/.env 后再填入真实值（.env 已在 .gitignore 中忽略）
PORT=8788

# prod = 正式收款；test = 测试卡与测试商品
WAFFO_ENVIRONMENT=prod
WAFFO_MERCHANT_ID=MER_2tL8OGKHTKuNYq4nL9STls
WAFFO_STORE_ID=STO_4KnR0sTssq1XPnts82FLDh

# 二选一：整段 PEM（换行可写成 \n）或 base64 编码后的 PEM
WAFFO_PRIVATE_KEY=
# WAFFO_PRIVATE_KEY_BASE64=
# 也可以指向一个密钥文件（推荐，*.pem 已在 .gitignore 中忽略）
# WAFFO_PRIVATE_KEY_FILE=./pancake-private.pem

WAFFO_CURRENCY=USD
WAFFO_PRICE_ARBITRAGE=49.00
WAFFO_PRICE_STRATEGY=99.00

# 可选：固定商品 ID，避免服务端首次运行时自动建品
# WAFFO_PRODUCT_ARBITRAGE=PROD_xxx
# WAFFO_PRODUCT_STRATEGY=PROD_xxx

# 支付成功后的回跳地址（网站部署地址）
SITE_URL=https://arbpilot.trade

# 必须是公网可达的 https 地址，Pancake 才能把 webhook 推过来
PUBLIC_BASE_URL=https://pay.arbpilot.trade

# 允许的前端来源（逗号分隔）
ALLOWED_ORIGINS=https://arbpilot.trade,tauri://localhost,http://tauri.localhost

# 账号服务：/api/checkout 必须先登录，未配置时收银台一律 401
ACCOUNTS_URL=http://127.0.0.1:8789
ACCOUNTS_INTERNAL_TOKEN=dev-internal-token

# 执行器：策略发布定价与订阅状态回写
EXECUTOR_URL=http://127.0.0.1:8787
EXECUTOR_TOKEN=dev-local-token

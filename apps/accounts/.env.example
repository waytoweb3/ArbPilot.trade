# 复制为 apps/accounts/.env 后再填入真实值（.env 已在 .gitignore 中忽略）
PORT=8789

# 账号库；与执行器共用同一个 Postgres 实例即可，表前缀互不冲突。
DATABASE_URL=postgres://arbpilot:arbpilot@127.0.0.1:5432/arbpilot

# 登录后回跳的网站地址（会作为允许的 redirect_uri 前缀）
SITE_URL=http://localhost:1421

# 必须是公网可达的 https 地址，OAuth 商家后台要填同一个回调地址
PUBLIC_BASE_URL=http://127.0.0.1:8789

# 托管与非托管用户统一使用 Google 登录
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://127.0.0.1:8789/api/auth/google/callback

# 访问 Google 需要代理时填写（只作用于 OAuth 出站请求，不影响本机服务）
# ARBPILOT_OAUTH_PROXY=http://127.0.0.1:7897

# 与 apps/payments 共享的内部令牌（支付服务回写订阅状态用）
INTERNAL_TOKEN=dev-internal-token
PAYMENTS_URL=http://127.0.0.1:8788

# 运营后台（https://你的站点/admin）访问令牌；留空则后台接口禁用
# 生成：openssl rand -hex 24
ADMIN_TOKEN=

# 作者身份同步到本机执行器
EXECUTOR_URL=http://127.0.0.1:8787
EXECUTOR_TOKEN=dev-local-token

# 权益令牌签名密钥（Ed25519，PKCS8 PEM）。留空会自动生成临时密钥，仅供本地调试。
# 生成：openssl genpkey -algorithm ed25519 -out license-private.pem
LICENSE_PRIVATE_KEY_FILE=./license-private.pem
# LICENSE_PRIVATE_KEY=
# LICENSE_PUBLIC_KEY=

LICENSE_TTL_HOURS=24
SESSION_TTL_DAYS=30
DEVICE_CODE_TTL_SECS=900

# 额外允许的前端来源（逗号分隔）
# ALLOWED_ORIGINS=https://arbpilot.trade,tauri://localhost

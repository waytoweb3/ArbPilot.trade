{
  "name": "arbpilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm --filter @arbpilot/desktop dev",
    "dev:desktop": "pnpm --filter @arbpilot/desktop tauri dev",
    "dev:executor": "cargo run -p arbpilot-executor",
    "build": "pnpm --filter @arbpilot/desktop build",
    "build:desktop": "pnpm --filter @arbpilot/desktop tauri build",
    "check": "cargo check --workspace && pnpm --filter @arbpilot/desktop exec tsc --noEmit",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f deploy/docker-compose.yml down"
  }
}
